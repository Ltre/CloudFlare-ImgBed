{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imgbed-disk-local-pages",
  "compatibility_date": "2026-09-01",
  "pages_build_output_dir": "./frontend-dist",
  "kv_namespaces": [
    { "binding": "img_url", "id": "22222222222222222222222222222222" }
  ],
  "d1_databases": [
    {
      "binding": "img_d1",
      "database_name": "imgbed_disk_local",
      "database_id": "11111111-1111-4111-8111-111111111111",
      "preview_database_id": "img_d1"
    }
  ],
  "r2_buckets": [
    { "binding": "img_r2", "bucket_name": "imgbed-disk-local-r2" }
  ],
  "vars": {
    "DISK_S3_ACCESS_KEY": "WRANGLER_LOCAL_TEST_ONLY",
    "DISK_S3_SECRET_KEY": "WRANGLER_LOCAL_TEST_SECRET_NEVER_USE_IN_PRODUCTION"
  }
}
